.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Local model artifacts.
pretrained/
outputs/
examples/*
!examples/*.md
runs/

# Large or transient runtime files.
*.safetensors
*.bin
*.pt
*.pth
*.onnx
*.log

# Live access credentials and operator pairing material.
*.key
*.pem
*live-auth*.json
*pairing-payload*

# Code-signing material for the local macOS capture app. A .p12 carries a private
# key and a .keychain-db carries the signing identity; neither may ever be committed.
*.p12
*.crt
*.keychain-db
*.keychain
