# Host-local Account product profile. Copy to ops/moss-account.env; systemd does not expand ~.
MOSS_GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
MOSS_GOOGLE_CLIENT_SECRET_FILE=REPLACE_WITH_ABSOLUTE_PATH/google-client-secret
MOSS_OAUTH_COOKIE_SECRET_FILE=REPLACE_WITH_ABSOLUTE_PATH/oauth-cookie-secret
MOSS_TLS_CERTFILE=REPLACE_WITH_TRUSTED_CERTIFICATE_PATH/tls.crt
MOSS_TLS_KEYFILE=REPLACE_WITH_ABSOLUTE_PATH/tls.key
MOSS_LIVE_PROVIDER_MANIFEST=REPLACE_WITH_ABSOLUTE_PATH/live-provider-manifest.json
MOSS_LIVE_HELPER_LEASE_SECONDS=30
MOSS_PHASE2_DATABASE=REPLACE_WITH_ABSOLUTE_PATH/moss-phase2.sqlite3
MOSS_PHASE2_CONTROL_SOCKET=REPLACE_WITH_ABSOLUTE_PATH/phase2-control.sock
MOSS_FILE_WORK_ROOT=REPLACE_WITH_ABSOLUTE_PATH/file-work
MOSS_MEETING_AUDIO_ROOT=REPLACE_WITH_ABSOLUTE_PATH/meetings
MOSS_GPU_MEMORY_UTILIZATION=0.30
MOSS_MAX_MODEL_LEN=16384
MOSS_MAX_NUM_SEQS=2
MOSS_MAX_NEW_TOKENS=12000
