[Unit]
Description=MOSS Transcribe Diarize vLLM API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/moss-transcribe-diarize/vllm.env
ExecStart=%h/.local/share/moss-transcribe-diarize/account-current/bin/mtd-vllm
Restart=on-failure
RestartSec=15
TimeoutStopSec=120
KillSignal=SIGINT

[Install]
WantedBy=default.target
