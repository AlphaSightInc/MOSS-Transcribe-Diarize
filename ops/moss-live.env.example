# Live profile for the second web service: TLS on port 7861, beside the untouched plaintext
# batch service on 7860. Copy this file to `ops/moss-live.env` on the deployment host and
# replace every REPLACE_WITH_ path. `ops/moss-live.env` is host-local and untracked; this
# example is the tracked template that `moss-live-web.service` and `ops/start-web.sh` agree on.
#
# systemd reads an EnvironmentFile literally: no shell runs, `$HOME` and `~` are NOT expanded,
# and values are not word-split. Every path below must therefore be absolute.
#
# The live unit loads `ops/moss.env` first and this file second, so the shared vLLM tuning
# applies and only the live-profile keys are overridden.

MOSS_LIVE_ENABLED=1

# The live listener. `--live` applies TLS to the whole uvicorn listener, so the live service
# must not bind the plaintext batch port; `ops/start-web.sh` refuses 7860 here.
MOSS_WEB_PORT=7861

# The live service must not share the batch job directory; `ops/start-web.sh` refuses
# `<checkout>/runs` here.
MOSS_RUNS_DIR=/mnt/d/Coding/MOSS-Transcribe-Diarize/live-runs

# Written by `ops/finalize-live-provider-manifest.py` from the reviewed merge SHA.
MOSS_LIVE_PROVIDER_MANIFEST=REPLACE_WITH_ABSOLUTE_PATH/live/live-provider-manifest.json

# Operator-owned live access state. Contains device and pairing secrets: never commit it,
# never copy it off the host.
MOSS_LIVE_AUTH_STATE=REPLACE_WITH_ABSOLUTE_PATH/live/live-auth.json

# Written by `ops/generate-live-tls.sh`. The certificate's SHA-256 over its DER bytes is the
# pin every paired Mac stores, so replacing this pair invalidates every existing pairing.
MOSS_LIVE_TLS_CERTFILE=REPLACE_WITH_ABSOLUTE_PATH/live/live.crt
MOSS_LIVE_TLS_KEYFILE=REPLACE_WITH_ABSOLUTE_PATH/live/live.key

# Helper lease, seconds. 30 is the contract value the Mac client's heartbeat cadence assumes.
MOSS_LIVE_HELPER_LEASE_SECONDS=30
