# Live profile for the second web service: TLS on port 7861, beside the untouched plaintext
# batch service on 7860. Copy this file to `ops/moss-live.env` on the deployment host and
# replace every REPLACE_WITH_ path. `ops/moss-live.env` is host-local and untracked; this
# example is the tracked template that `moss-live-web.service` and `ops/start-web.sh` agree on.
#
# systemd reads an EnvironmentFile literally: no shell runs, `$HOME` and `~` are NOT expanded,
# and values are not word-split. Every path below must therefore be absolute.
#
# The live unit loads `ops/moss.env` first and this file second, so the shared vLLM tuning
# applies and only the live-profile keys are overridden.

MOSS_LIVE_ENABLED=1

# The live listener. `--live` applies TLS to the whole uvicorn listener, so the live service
# must not bind the plaintext batch port; `ops/start-web.sh` refuses 7860 here.
MOSS_WEB_PORT=7861

# The live service must not share the batch job directory; `ops/start-web.sh` refuses
# `<checkout>/runs` here.
MOSS_RUNS_DIR=/mnt/d/Coding/MOSS-Transcribe-Diarize/live-runs

# Written by `ops/finalize-live-provider-manifest.py` from the reviewed merge SHA.
MOSS_LIVE_PROVIDER_MANIFEST=REPLACE_WITH_ABSOLUTE_PATH/live/live-provider-manifest.json

# Operator-owned live access state. Contains device and pairing secrets: never commit it,
# never copy it off the host.
MOSS_LIVE_AUTH_STATE=REPLACE_WITH_ABSOLUTE_PATH/live/live-auth.json

# Written by `ops/generate-live-tls.sh`. The certificate's SHA-256 over its DER bytes is the
# pin every paired Mac stores, so replacing this pair invalidates every existing pairing.
MOSS_LIVE_TLS_CERTFILE=REPLACE_WITH_ABSOLUTE_PATH/live/live.crt
MOSS_LIVE_TLS_KEYFILE=REPLACE_WITH_ABSOLUTE_PATH/live/live.key

# Helper lease, seconds. 30 is the contract value the Mac client's heartbeat cadence assumes.
MOSS_LIVE_HELPER_LEASE_SECONDS=30

# --- Live session audio retention (ADR-0003) - OFF, and commented out on purpose ------------
#
# Retention is opt-in (D2). With no root declared the service keeps today's one-span horizon
# and writes no meeting audio anywhere, which is the posture every recorded certification run
# was measured against. Uncommenting the two keys below turns retention on for every session
# this host runs, so it is a deliberate act by an operator and never a side effect of copying
# this template. That is why these lines ship commented rather than as REPLACE_WITH_ paths.
#
# The root must be absolute, outside the checkout (a rollback is `git checkout <sha>` and
# `git clean` must never be a reaper), on a filesystem that enforces modes, and NOT the
# filesystem the batch runs tree lives on - a runaway tape answers 507 to the batch service's
# uploads without ever touching it. On this deployment `/mnt/d` fails both of the last two and
# the WSL ext4 home passes. The service refuses a root that breaks any of these at startup,
# rather than starting with retention silently disabled.
#
# MOSS_LIVE_RETENTION_ROOT=REPLACE_WITH_ABSOLUTE_PATH/.local/share/moss-transcribe-diarize/live
#
# Per-session cap, bytes. Required whenever a root is declared, because neither end has a safe
# default: zero would mean "never tape" and unbounded is the runaway above. Meeting audio is
# three 16 kHz mono tracks, ~0.3 GB/hr, so 2 GiB is about six hours of one meeting.
# MOSS_LIVE_RETENTION_MAX_BYTES=2147483648
#
# Seconds a tape outlives its own meeting. Absent means 0 - the tape is deleted at the next
# reap once the session ends - which is the only value a tool may choose. A positive value is
# this deployment stating that meeting audio survives the meeting, and it is the whole of the
# difference between the PRD's audio clause holding literally at every post-meeting boundary
# and holding only within a stated window.
# MOSS_LIVE_RETENTION_TTL_SECONDS=0
