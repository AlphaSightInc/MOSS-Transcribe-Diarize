[Unit]
Description=MOSS Transcribe Diarize live web app (TLS)
After=network-online.target moss-vllm.service
Wants=network-online.target moss-vllm.service

[Service]
Type=simple
EnvironmentFile=-/mnt/d/Coding/MOSS-Transcribe-Diarize/ops/moss.env
EnvironmentFile=/mnt/d/Coding/MOSS-Transcribe-Diarize/ops/moss-live.env
ExecStart=/bin/bash /mnt/d/Coding/MOSS-Transcribe-Diarize/ops/start-web.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=default.target
